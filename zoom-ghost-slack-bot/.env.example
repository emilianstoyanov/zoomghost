# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
DEBUG=false

# Comma-separated browser origins. Overrides the defaults in main.py.
# Production default, when CORS_ORIGINS is unset and APP_ENV=production:
#   https://zoomghost.com,https://www.zoomghost.com
# Any other APP_ENV defaults to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# Where Slack and Zoom OAuth send the browser after connect. No trailing slash.
FRONTEND_URL=https://YOUR_FRONTEND_HOST

REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=https://YOUR_SLACK_BOT_HOST/api/slack/oauth/callback

ZOOM_CLIENT_ID=YOUR_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=YOUR_ZOOM_CLIENT_SECRET
ZOOM_REDIRECT_URI=https://YOUR_SLACK_BOT_HOST/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=YOUR_ZOOM_WEBHOOK_SECRET
ZOOM_SKIP_SIGNATURE_CHECK=false

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-central-1
SES_SOURCE_EMAIL=noreply@example.com
AWS_ZOOM_WEBHOOK_URL=https://YOUR_ZOOM_BOT_HOST/api/zoom/webhook

# Used only by scripts/ for local checks. Not required by the web process.
SLACK_TEST_USER_ID=
SLACK_TEST_TOKEN=
SUPABASE_USER_ID=
ZOOM_MEETING_ID=
ZOOM_TEST_DOWNLOAD_URL=
ZOOM_WEBHOOK_DOWNLOAD_URL=
ZOOM_WEBHOOK_DOWNLOAD_TOKEN=
